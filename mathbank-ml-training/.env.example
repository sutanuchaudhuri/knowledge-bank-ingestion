# Copy to .env (gitignored) before running any notebook or job script.
# This project should use a READ-ONLY Postgres role where possible — it must never
# write to canonical content tables (requirements/55 §1, requirements/54 §16 invariant #6
# equivalent). Writes are limited to the `ml.*` schema (feature snapshots, training runs,
# model registry) — see mathbank-db/sql/<new migration>_ml_schema.sql (TODO: not yet
# created; requirements/55 does not scaffold this migration in this pass because the
# `ml` schema's exact DDL should be reviewed once the pydantic contracts in contracts.py
# are considered final, to avoid migrating twice).

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=mathbank
POSTGRES_USER=mathbank_ml_readonly
POSTGRES_PASSWORD=change-me
POSTGRES_SSLMODE=

NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# Object storage for training datasets (Parquet) and model artifacts (requirements/55 §4
# "storage" / requirements/13 §4). TODO: confirm bucket naming convention against
# mathbank-rest's existing MATHBANK_OBJECT_BACKEND=s3 convention before wiring this up.
ML_TRAINING_ARTIFACT_BUCKET=
AWS_REGION=

# SageMaker (requirements/54 §4, phases 1-3 — not used by phase 0 local-only work).
SAGEMAKER_ROLE_ARN=
SAGEMAKER_EXECUTION_IMAGE_URI=
