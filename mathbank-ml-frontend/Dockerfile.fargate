# Fargate container image for mathbank-ml-frontend — plain Next.js, no sibling-package
# dependency, so the build context is this directory itself (not the repo root):
#   docker build --platform linux/arm64 -f Dockerfile.fargate -t mathbank-ml-frontend-fargate .
FROM node:22-slim

WORKDIR /app
COPY . /app
RUN npm ci && npm run build

EXPOSE 5175
ENV NODE_ENV=production
CMD ["npx", "next", "start", "-p", "5175", "-H", "0.0.0.0"]
