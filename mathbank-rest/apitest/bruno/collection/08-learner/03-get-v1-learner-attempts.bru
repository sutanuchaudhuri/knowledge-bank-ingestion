meta {
  name: GET /v1/learner/attempts
  type: http
  seq: 3
  tags: [
    read
    learner
  ]
}

get {
  url: {{baseUrl}}/v1/learner/attempts?limit=20
  body: none
  auth: bearer
}

params:query {
  limit: 20
  ~offset: 0
}

auth:bearer {
  token: {{learnerToken}}
}

assert {
  res.status: lt 500
}

script:post-response {
  const body = res.body;
  const rows = Array.isArray(body) ? body : (body && Array.isArray(body.items) ? body.items : []);
  const first = rows[0] || {};
  if (first.attempt_id) bru.setVar("outcomeAttemptId", String(first.attempt_id));
}

docs {
  **Get Attempts**

  `GET /v1/learner/attempts`

  Auth: learner bearer token (`{{learnerToken}}`).
}
