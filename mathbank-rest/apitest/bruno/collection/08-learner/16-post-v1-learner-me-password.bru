meta {
  name: [WRITE] POST /v1/learner/me/password
  type: http
  seq: 16
  tags: [
    write
    learner
  ]
}

post {
  url: {{baseUrl}}/v1/learner/me/password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{learnerToken}}
}

body:json {
  {
    "current_password": "{{learnerPassword}}",
    "new_password": "Bruno-learner-2"
  }
}

assert {
  res.status: lt 500
}

docs {
  **Change My Password**

  `POST /v1/learner/me/password`

  Change the password of a password account (LRN-E07): needs the current password (403 when wrong), 409 for an account
  that signs in through its identity provider, 429 after 5 attempts in 15 minutes. Every older token stops working; the
  response carries a fresh one.

  Auth: learner bearer token (`{{learnerToken}}`).

  **[WRITE]** changes server state. `dev-readonly` answers 423 (AWS_READONLY); `test-writable` writes only to the `-test` resources.
}
