meta {
  name: GET /v1/learner/micro-course-enrollments
  type: http
  seq: 12
  tags: [
    read
    learner
  ]
}

get {
  url: {{baseUrl}}/v1/learner/micro-course-enrollments?limit=20
  body: none
  auth: bearer
}

params:query {
  ~status: IN_PROGRESS
  limit: 20
}

auth:bearer {
  token: {{learnerToken}}
}

assert {
  res.status: lt 500
}

script:post-response {
  const body = res.body;
  const rows = Array.isArray(body) ? body : (body && Array.isArray(body.items) ? body.items : []);
  const first = rows[0] || {};
  if (first.enrollment_id) bru.setVar("enrollmentId", String(first.enrollment_id));
}

docs {
  **List My Micro Course Enrollments**

  `GET /v1/learner/micro-course-enrollments`

  The learner's own micro-course enrollments, newest first (LRN-E12): ``{items, total}``.

  Auth: learner bearer token (`{{learnerToken}}`).
}
