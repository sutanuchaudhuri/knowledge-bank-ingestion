meta {
  name: [WRITE] POST /v1/quiz-integration/papers/{quiz_id}/questions/{question_id}/respond
  type: http
  seq: 19
  tags: [
    write
    admin
  ]
}

post {
  url: {{baseUrl}}/v1/quiz-integration/papers/{{quizId}}/questions/{{questionId}}/respond
  body: json
  auth: bearer
}

headers {
  X-Admin-Api-Key: {{adminKey}}
}

auth:bearer {
  token: {{learnerToken}}
}

body:json {
  {
    "student_id": "{{studentId}}"
  }
}

assert {
  res.status: lt 500
}

docs {
  **Respond**

  `POST /v1/quiz-integration/papers/{quiz_id}/questions/{question_id}/respond`

  Auth: learner bearer token (`{{learnerToken}}`) and admin key (`{{adminKey}}`).

  **[WRITE]** changes server state. `dev-readonly` answers 423 (AWS_READONLY); `test-writable` writes only to the `-test` resources.
}
