meta {
  name: GET /v1/problems
  type: http
  seq: 2
  tags: [
    read
    public
  ]
}

get {
  url: {{baseUrl}}/v1/problems?limit=20
  body: none
  auth: none
}

params:query {
  ~competition: AIME
  ~year_min: 1
  ~year_max: 1
  ~concept: {{conceptSlug}}
  ~technique: {{techniqueSlug}}
  limit: 20
  ~offset: 0
}

assert {
  res.status: eq 200
}

script:post-response {
  const body = res.body;
  const rows = Array.isArray(body) ? body : (body && Array.isArray(body.items) ? body.items : []);
  const first = rows[0] || {};
  if (first.canonical_code) bru.setVar("canonicalCode", String(first.canonical_code));
}

docs {
  **Get Problems**

  `GET /v1/problems`

  Auth: none (public).
}
