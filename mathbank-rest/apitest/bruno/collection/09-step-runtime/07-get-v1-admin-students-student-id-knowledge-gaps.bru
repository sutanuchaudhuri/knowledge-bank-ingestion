}

auth:bearer {
  token: {{learnerToken}}
}

assert {
  res.status: lt 500
}

docs {
  **Admin Student Gaps**

  `GET /v1/admin/students/{student_id}/knowledge-gaps`

  Internal (X-Admin-Api-Key): a student's knowledge-gap hypotheses across attempts.

