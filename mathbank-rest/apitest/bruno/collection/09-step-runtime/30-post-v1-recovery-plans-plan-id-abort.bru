meta {
  name: [WRITE] POST /v1/recovery-plans/{plan_id}/abort
  type: http
  seq: 30
  tags: [
    write
    learner
  ]
}

post {
  url: {{baseUrl}}/v1/recovery-plans/{{planId}}/abort
  body: json
  auth: bearer
}

headers {
  ~Idempotency-Key: {{$guid}}
}

auth:bearer {
  token: {{learnerToken}}
}

body:json {
  {
    "state_version": 1
  }
}

assert {
  res.status: lt 500
}

docs {
  **Abort Recovery**

  `POST /v1/recovery-plans/{plan_id}/abort`

  Leave the detour early: open plans end ABORTED, remaining items SKIPPED, back to the origin step.

  Auth: learner bearer token (`{{learnerToken}}`).

  **[WRITE]** changes server state. `dev-readonly` answers 423 (AWS_READONLY); `test-writable` writes only to the `-test` resources.
}
