# Copy to .env (gitignored) before running the app or `make test-connectivity`.
# Values must match what you provisioned via mathbank-db/ and mathbank-graph/ Makefiles.

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=mathbank
POSTGRES_USER=mathbank_app
POSTGRES_PASSWORD=change-me

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
