# Copy to .env (gitignored) before running the app or `make test-connectivity`.
# Values must match what you provisioned via mathbank-db/ and mathbank-graph/ Makefiles
# for local dev, or mathbank-graph/remote.env for the hosted Neon/AuraDB stack.

# Put OPENAI_API_KEY in root .env and run make sync-openai-key.
# Shell keys are ignored; root .env is authoritative. A service .env key is
# supported only when no root .env exists. See GOTCHAS.md #6.
# OPENAI_API_KEY=your-key

# Local Postgres (mathbank-db) defaults shown; for Neon set POSTGRES_HOST to the
# pooler hostname, POSTGRES_PORT=5432, POSTGRES_DB=neondb (or your db name), and
# POSTGRES_SSLMODE=require.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=mathbank
POSTGRES_USER=mathbank_app
POSTGRES_PASSWORD=change-me
POSTGRES_SSLMODE=

# Local Neo4j defaults shown; for AuraDB use the neo4j+s:// URI and the
# username/password from your Aura console credentials download.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# Paid catalog-relationship generation and independent semantic review.
# Question enrichment keeps its existing model. Model overrides enter the
# catalog job fingerprint; changing them can make existing anchors due again.
RELATIONSHIP_MODEL=gpt-4.1
RELATIONSHIP_VERIFIER_MODEL=gpt-4.1

# Student login (learner.* schema) — HS256 JWT signing secret. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required in every deployment other than throwaway local dev (see config.py).
JWT_SECRET=change-me-to-a-long-random-value

# Admin endpoints (/v1/admin/*) — shared X-Admin-Api-Key header value.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=change-me-to-a-long-random-value
