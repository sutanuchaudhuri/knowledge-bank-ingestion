# Copy to .env (gitignored). OPENAI_API_KEY should already be exported in your
# shell (e.g. ~/.zshrc) — do not duplicate secrets into this file if so;
# python-dotenv only fills in variables not already set in the environment.

# OPENAI_API_KEY=sk-...        # only if not already exported in your shell

# LiteLLM model string routed to OpenAI — see https://docs.litellm.ai/docs/providers/openai
MATHBANK_AGENT_MODEL=openai/gpt-4o-mini

# Base URL of the mathbank-rest FastAPI service (hybrid RAG + corpus queries)
MATHBANK_REST_BASE_URL=http://127.0.0.1:8000

# Who is making requests to the agent: ANONYMOUS or ADMIN (student profiles come later)
MATHBANK_AGENT_DEFAULT_ROLE=ANONYMOUS

# Postgres session storage (falls back to root .env, then REST .env).
# Use the same server/database as REST; ADK tables live in agent_sessions.
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5433
# POSTGRES_DB=mathbank
# POSTGRES_USER=mathbank_app
# POSTGRES_PASSWORD=your-local-password
# POSTGRES_SSLMODE=disable
