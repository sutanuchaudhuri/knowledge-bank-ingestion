{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Misconception Evidence Rule",
  "type": "object",
  "required": [
    "rule_key",
    "misconception_id",
    "semantic_action",
    "error_signature",
    "predicate",
    "evidence_weight"
  ],
  "properties": {
    "rule_key": {
      "type": "string"
    },
    "misconception_id": {
      "type": "string"
    },
    "semantic_action": {
      "type": "string"
    },
    "error_signature": {
      "type": "string"
    },
    "predicate": {
      "type": "object"
    },
    "evidence_weight": {
      "type": "number",
      "minimum": -1,
      "maximum": 1
    },
    "requires_probe": {
      "type": "boolean"
    },
    "diagnostic_learning_item_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "feedback_template_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "intervention_code": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}