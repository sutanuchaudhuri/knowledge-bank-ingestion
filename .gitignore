# archived source material — large, not version-controlled
archive/

# Node (mathbank-web)
node_modules/
.next/

# Python
__pycache__/
*.py[cod]
*.pyo
.Python
.venv/
venv/
env/
*.egg-info/
dist/
build/
.eggs/

# Byte-compiled
*.pyc

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Editors
.DS_Store
.vscode/settings.json
*.swp
*.swo
.idea/

# Env files
.env
.env.*
*.env
!.env.example
!*.env.example

# sync-env.sh backups (e.g. remote.env.bak.20261004121149) — these don't
# match the *.env pattern above since they don't end in .env, but they
# contain the same live credentials and must never be committed.
*.bak.*
*.sync-*

# Secrets / credentials
credentials.json
token.json
service_account*.json
Neo4j-*-Created-*.txt
*.pem

# Background dev-server state (make start/stop pidfiles + logs)
.server.pid
.server.log

# Pipeline runtime artefacts
data/
!mathbank-db/data/
mathbank-db/data/*
!mathbank-db/data/pedagogy/
batches/
logs/
reports/

# GCS / Drive receipts produced locally
receipts/
