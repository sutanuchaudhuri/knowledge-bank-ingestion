# Copy to .env (gitignored) and fill in real values before running `make` targets.

# Where Postgres data/logs live — must be on the external (APFS) drive.
EXTERNAL_DB_ROOT=/Volumes/External/Developer/databases

# Superuser created by `make init` (local Unix-socket connections are trust-authenticated,
# so this password is only required for TCP/host connections).
PG_SUPERUSER=mathbank_admin
PG_SUPERUSER_PASSWORD=change-me

# Application role + database created by `make create-db`.
APP_DB=mathbank
APP_USER=mathbank_app
APP_DB_PASSWORD=change-me

# Port is intentionally non-default (5433) to avoid clashing with any other local Postgres.
PG_PORT=5433
