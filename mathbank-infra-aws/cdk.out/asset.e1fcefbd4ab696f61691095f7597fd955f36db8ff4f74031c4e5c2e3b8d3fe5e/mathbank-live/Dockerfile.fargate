# Fargate container image for mathbank-live (requirements/62 §5 — Socket.IO needs a
# persistent process, not a request-scoped Lambda).
#
# Build context is THIS directory, not the repo root — same GOTCHAS.md §44 self-nesting
# issue mathbank-web's own Dockerfile.fargate comment explains in full. The sibling
# mathbank-widgets package and this repo's shared mathbank-scripts/ are reached via
# BuildKit additional build contexts instead (fargate_web_stack.py's `build_contexts=`).
#
# Custom server (server.mjs) ⇒ do NOT use Next.js `output: "standalone"` (see
# server.mjs's own comment) — this image ships full node_modules + source, which is
# fine for Fargate (no Lambda-style image-size/cold-start pressure).
#   docker buildx build --platform linux/arm64 -f Dockerfile.fargate \
#     --build-context mathbank_widgets=../mathbank-widgets \
#     --build-context mathbank_scripts=../mathbank-scripts -t mathbank-live-fargate .
FROM node:22-slim

WORKDIR /app
COPY --from=mathbank_widgets . /app/mathbank-widgets
COPY . /app/mathbank-live
COPY --from=mathbank_scripts fetch-secrets.mjs /app/mathbank-live/scripts/fetch-secrets.mjs
WORKDIR /app/mathbank-live
RUN npm ci && npm run build

EXPOSE 5174
ENV NODE_ENV=production
ENV LIVE_HOST=0.0.0.0
CMD ["sh", "-c", "node scripts/fetch-secrets.mjs && node server.mjs"]
