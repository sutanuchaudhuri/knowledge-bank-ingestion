# Copy to .env (gitignored).

# The existing mathbank-rest REST API this server wraps (requirements/49 doc 01 §4 —
# "FastMCP handlers call the existing MathBank service layer," never duplicated SQL).
MATHBANK_REST_BASE_URL=http://localhost:8000

# Transport for `python -m mathbank_mcp_competitions` (see __main__.py). "stdio" is what
# most MCP hosts (Claude Desktop, etc.) and the bundled agent demo use; "http" runs it as
# a standalone network server other agents/services can point at.
MCP_TRANSPORT=stdio
MCP_HTTP_PORT=9000

OPENAI_API_KEY=
