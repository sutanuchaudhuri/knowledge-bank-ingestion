# Local Postgres (mathbank-db) defaults shown; for the shared Neon instance copy the
# POSTGRES_* values from ../mathbank-rest/.env (lower-cased, see config.py).
postgres_host=127.0.0.1
postgres_port=5433
postgres_db=mathbank
postgres_user=mathbank_app
postgres_password=change-me
postgres_sslmode=

# Sourced from the repository root .env's OPENAI_API_KEY (GOTCHAS.md §6 convention).
openai_api_key=

openai_model=gpt-4.1-mini
mcp_competitions_script=../mathbank-mcp-competitions/src/mathbank_mcp_competitions/__main__.py
mcp_competitions_python=../mathbank-mcp-competitions/.venv/bin/python3
studio_object_root=./data/studio_objects
job_ttl_days=1
worker_poll_seconds=2.0
admin_api_key=change-me-to-match-mathbank-rest
