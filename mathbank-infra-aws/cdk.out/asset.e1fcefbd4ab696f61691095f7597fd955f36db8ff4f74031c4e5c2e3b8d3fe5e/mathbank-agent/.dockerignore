# Docker build-context exclusions for mathbank-agent's own Dockerfile.lambda, whose
# build context is this directory (GOTCHAS.md #44 — scoped per-service, not repo root).
# .env*/.env.bak.* exclusions are load-bearing: GOTCHAS.md #43 — an earlier version of
# this Dockerfile (when it used repo-root context) leaked the real .env into a pushed
# image before this exclusion existed.
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/
.server.log
.server.pid
.env
.env.*
!.env.example
Dockerfile.lambda
tests/
