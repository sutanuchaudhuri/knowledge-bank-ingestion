# Server-side only (read by app/api/agent/* route handlers) — the browser
# never sees or calls this URL directly, so mathbank-agent needs no CORS config.
MATHBANK_AGENT_BASE_URL=http://127.0.0.1:8001

# Server-side only (read by app/api/graph/* route handlers) — direct Bolt
# connection to the mathbank-graph Neo4j instance, see mathbank-graph/.env.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Server-side only (read by app/api/rest/* route handlers) — the browser
# never calls mathbank-rest directly, only this app's own /api/rest/* routes.
MATHBANK_REST_BASE_URL=http://127.0.0.1:8000

# Server-side only (read by app/api/rest/admin/* route handlers) — must match
# mathbank-rest/.env's ADMIN_API_KEY. The browser never sees this value.
MATHBANK_ADMIN_API_KEY=change-me-to-match-mathbank-rest-env

# Admin web login — a username/password that is gated by Cognito group membership
# (COGNITO_ADMIN_GROUP below), not a predefined env-configured credential (requirements/64
# §6a). The actual /v1/admin/* authorization is still the static MATHBANK_ADMIN_API_KEY
# above, unchanged — that is a service credential, not a human admin's.
ADMIN_LOGIN_USERNAME=admin
ADMIN_LOGIN_PASSWORD=ChangeMe123!

# Signs the admin session cookie (HMAC) so it can't be forged by guessing a
# cookie value — any long random string, never sent to the browser. Must match
# mathbank-live/.env's value for the two apps' admin sessions to be
# recognized on the same host (see lib/session.js's comment).
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# AWS Cognito — a real, shared User Pool across mathbank-web, mathbank-live, and
# mathbank-exam-agent (requirements/64 §6a — one account per student/admin, platform
# wide). Needs a live AWS SSO session locally (`aws login`) even in dev, since these are
# real AWS API calls; the deployed Lambda would use its execution role instead.
AWS_REGION=us-east-2
COGNITO_USER_POOL_ID=us-east-2_xxxxxxxxx
COGNITO_CLIENT_ID=change-me-this-apps-own-cognito-app-client-id
COGNITO_CLIENT_SECRET=change-me-this-apps-own-cognito-app-client-secret
COGNITO_ADMIN_GROUP=Admins
