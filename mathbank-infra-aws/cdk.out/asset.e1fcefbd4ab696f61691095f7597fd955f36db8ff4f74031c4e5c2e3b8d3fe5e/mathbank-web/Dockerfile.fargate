# Fargate container image for mathbank-web — one of three Next.js apps moved from
# the originally-planned Amplify Hosting to Fargate (requirements/62 §6, revised:
# Amplify Hosting's SSR path requires a Git-connected app and a GitHub OAuth token only
# the repo owner can authorize; Fargate needs no such external credential and this repo
# already has the exact same Docker/ECR pipeline proven for mathbank-live).
#
# Build context is THIS directory, not the repo root — confirmed live (requirements/63,
# GOTCHAS.md §44): a REPO_ROOT-context build invoked more than once within one CDK synth
# (this stack builds 3 images) self-nests into mathbank-infra-aws/cdk.out even with
# `exclude=[...]` set, exactly like mathbank-manim-studio's own stack hit first. The
# sibling mathbank-widgets package (and this repo's shared mathbank-scripts/) are reached
# via BuildKit *additional build contexts* instead — see fargate_web_stack.py's
# `build_contexts=` for each app. Requires the docker-buildx CLI plugin locally
# (`brew install docker-buildx`); CDK enables BuildKit automatically once
# `build_contexts` is set.
#   docker buildx build --platform linux/arm64 -f Dockerfile.fargate \
#     --build-context mathbank_widgets=../mathbank-widgets \
#     --build-context mathbank_scripts=../mathbank-scripts -t mathbank-web-fargate .
FROM node:22-slim

WORKDIR /app
COPY --from=mathbank_widgets . /app/mathbank-widgets
COPY . /app/mathbank-web
COPY --from=mathbank_scripts fetch-secrets.mjs /app/mathbank-web/scripts/fetch-secrets.mjs
WORKDIR /app/mathbank-web
RUN npm ci && npm run build

EXPOSE 5173
ENV NODE_ENV=production
# Fetches secrets from SSM into .env.production.local (Next.js's own loader picks it up
# with top precedence) before starting — see fetch-secrets.mjs's module docstring.
CMD ["sh", "-c", "node scripts/fetch-secrets.mjs && npx next start -p 5173 -H 0.0.0.0"]
