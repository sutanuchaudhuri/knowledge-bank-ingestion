# Remote (cloud) credentials for the migrated mathbank stack — copy to
# remote.env (gitignored) and fill in real values. One file for both halves
# of the migration (see GOTCHAS.md #14/#15, DATABASES.md "Remote (current)").
#
# Usage: make -C mathbank-graph project-remote
# (or `set -a; source mathbank-graph/remote.env; set +a` for one-off scripts —
# but `unset` afterward, see GOTCHAS.md #14).

# ── Neon (remote Postgres + pgvector) ────────────────────────────────────────
# From your Neon project's connection details (console.neon.tech).
NEON_PG_HOST=change-me.pooler.region.aws.neon.tech
NEON_PG_PORT=5432
NEON_PG_DATABASE=neondb
NEON_PG_USER=neondb_owner
NEON_PG_PASSWORD=change-me
NEON_PG_SSLMODE=require
NEON_PG_CHANNEL_BINDING=require

# ── Neo4j AuraDB (remote graph) ───────────────────────────────────────────────
# Downloaded from the Aura console when you create the instance (a
# Neo4j-<instance-id>-Created-<date>.txt file — also gitignored).
NEO4J_URI=neo4j+s://change-me.databases.neo4j.io
NEO4J_USERNAME=change-me
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=change-me
AURA_INSTANCEID=change-me
AURA_INSTANCENAME=change-me
