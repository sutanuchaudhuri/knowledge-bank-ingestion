# Docker build-context exclusions for mathbank-ml-inference's own Dockerfile.lambda,
# whose build context is this directory (not the repo root, unlike mathbank-rest/
# mathbank-agent). See GOTCHAS.md #43 — .env must never enter a Lambda image.
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/
.server.log
.server.pid
.env
.env.*
!.env.example
Dockerfile.lambda
cdk.out/
