# Copy to .env (gitignored).

PORT=8010

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=mathbank
POSTGRES_USER=mathbank_ml_readonly
POSTGRES_PASSWORD=change-me
POSTGRES_SSLMODE=

# TODO: confirm whether this service needs its own Neo4j connection at all — requirements/56
# §2's endpoints are mostly Postgres-feature-snapshot-driven; only add this if a specific
# endpoint ends up needing a live structural graph read (most should read from a Postgres
# feature snapshot instead, per requirements/01 §4).
# NEO4J_URI=
# NEO4J_USERNAME=
# NEO4J_PASSWORD=

# Model artifact location — must match whatever mathbank-ml-training's registry wrote
# (requirements/55 §4 storage convention).
ML_MODEL_ARTIFACT_BUCKET=

# TODO (requirements/56 §5): cache backend — decide Redis vs in-process LRU vs a
# Postgres-backed cache table once request volume is known.
# CACHE_BACKEND=
