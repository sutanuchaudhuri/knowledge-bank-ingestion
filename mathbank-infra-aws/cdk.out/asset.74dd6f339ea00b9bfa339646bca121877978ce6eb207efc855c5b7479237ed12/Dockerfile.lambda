# Lambda container image for mathbank-mcp-competitions (requirements/62 §4.5,
# requirements/63). No sibling monorepo dependency — build context is this service's
# own directory (GOTCHAS.md #44 — never give a Docker asset a directory containing
# mathbank-infra-aws/cdk.out unless genuinely required):
#   docker build --platform linux/arm64 -f Dockerfile.lambda -t mathbank-mcp-competitions-lambda .
FROM public.ecr.aws/lambda/python:3.11

# Scoped package install (never a whole-directory COPY) — GOTCHAS.md #43: the real
# local .env never enters the image this way, since setuptools only packages files
# declared under [tool.setuptools.packages.find].
COPY . /tmp/mathbank-mcp-competitions
RUN pip install --no-cache-dir --only-binary=:all: "/tmp/mathbank-mcp-competitions[lambda]" && rm -rf /tmp/mathbank-mcp-competitions

CMD ["mathbank_mcp_competitions.lambda_handler.handler"]
