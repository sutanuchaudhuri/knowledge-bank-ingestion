# Copy to .env (gitignored) and fill in a real password before running `make` targets.

# Where Neo4j data/logs/import live — must be on the external (APFS) drive.
EXTERNAL_DB_ROOT=/Volumes/External/Developer/databases

# Password for the built-in `neo4j` user. Only effective if set BEFORE the first
# `make start` (neo4j-admin set-initial-password only works pre-first-boot).
NEO4J_PASSWORD=change-me

NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474

# Postgres connection (source of truth) used by etl/project_from_postgres.py
PG_PORT=5433
APP_DB=mathbank
APP_USER=mathbank_app
APP_DB_PASSWORD=change-me
