# mathbank-live — server-side only. Generate with `make sync-live-env` (root Makefile) from the root .env.
MATHBANK_REST_BASE_URL=http://127.0.0.1:8000
MATHBANK_ADMIN_API_KEY=change-me
ADMIN_LOGIN_USERNAME=admin
ADMIN_LOGIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me
ELEVEN_API_KEY=
LIVE_PORT=5174
# Optional: comma-separated extra origins allowed to open sockets (default: same host only)
# LIVE_ALLOWED_ORIGINS=
